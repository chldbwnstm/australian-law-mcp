# Copy to /etc/issue-agent/agent.env (0600). Never commit the populated file.
# Fine-grained PAT restricted to this repository; see docs/agent-automation.md.
AUTOMATION_GITHUB_TOKEN=
# Only explicitly listed provider keys can enter worker containers.
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Set this in systemd when using a non-default environment file:
# AUTOMATION_ENV_FILE=/etc/issue-agent/agent.env
