# au-law-mcp — environment variables
#
# There is NO API key. Every upstream source this server talks to is a keyless
# public endpoint, so the server starts with no credentials configured. The
# request context still carries an optional per-request API key (see
# src/lib/session-state.ts) so a future source that needs one can be plugged in
# without reworking the transport; the HTTP transport reads it from the `apikey`
# header. Leave it unset unless such a source is added.
#
# Every numeric setting below is validated as a whole integer at startup. An
# invalid value fails the boot instead of quietly disabling the limit it
# configures — `parseInt("60x")` is 60 and `NaN > limit` is false, and either
# one turns a security gate off with nothing in the logs to say so.

# ── Upstream HTTP behaviour ─────────────────────────────────────────────────
# Some upstream sites reject Node's default undici user agent. Override the
# browser-like default here if a source needs a different one.
# LAW_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Sent as the Referer header on every upstream request when set. Unset by
# default — only some sources require it.
# LAW_REFERER=https://www.legislation.gov.au/

# ── Optional browser fallback through Aside (macOS, off by default) ─────────
# Several publishers refuse this server outright — judgments.fedcourt.gov.au,
# AustLII, LawCite, the NSW and SA legislation registers, the ACCC — so those
# lookups answer [UPSTREAM_BLOCKED] with a deep link instead of results. Turn
# this on and the server may finish such a lookup by driving Aside, the browser
# app on this Mac, through its CLI. Aside is a real browser carrying the user's
# logged-in sessions, which is both why it gets past those gates and why the
# server may only point it at the blocked legal-source domains above. With
# Aside absent, or off this Mac, the setting does nothing: the answer is the
# blocked-source note it has always been.
#
# Off unless set to `1` or `true`. It is read as a VALUE, never as mere
# presence: the Claude Desktop extension sets this variable on every launch, to
# the literal string "true" or "false", because that is what the MCPB spec
# substitutes a boolean setting to — so "false" and "" are off, and a truthy
# presence check would read an untouched installation as on. Claude Desktop
# users set it from Settings → Extensions → Australian Law rather than here;
# this file is for the CLI and Codex hosts, which have no settings UI.
# AU_LAW_ASIDE=1

# Full path to the Aside CLI, for an installation outside the standard
# ~/.aside/cli/Aside CLI.app/Contents/MacOS/aside. Leave unset and the server
# looks there itself. An empty or whitespace-only value means unset — the
# desktop extension always supplies the variable, and supplies "" when its
# optional path field is blank. Ignored while AU_LAW_ASIDE is off.
# AU_LAW_ASIDE_COMMAND=/Users/you/.aside/cli/Aside CLI.app/Contents/MacOS/aside

# ── Per-request execution limits ────────────────────────────────────────────
# Request-wide upstream attempt budget, including retries. A JSON-RPC batch and
# every chain step share one budget.
# MCP_MAX_UPSTREAM_REQUESTS=48

# Maximum bytes read from one upstream response body (8 MiB). The Federal
# Register has no per-section endpoint — Act text arrives as whole epub volumes,
# and a large Act's volumes are megabytes each (the CCA's are 2.0 MiB and
# 4.1 MiB). Lowering this below ~5 MiB makes get_law_text fail on the largest
# Acts with an upstream error, which reads as "not found".
# MCP_MAX_UPSTREAM_BODY_BYTES=8388608

# Maximum upstream body bytes read by one outer request (32 MiB) — about four
# full-size volumes, so a chain can read a couple of Acts. Must be at least
# MCP_MAX_UPSTREAM_BODY_BYTES.
# MCP_MAX_TOTAL_UPSTREAM_BODY_BYTES=33554432

# Maximum characters returned in one MCP tool response.
# MCP_MAX_TOOL_RESPONSE_CHARS=50000

# Deadline for multi-step chain tools. On expiry the chain assembles whatever
# arrived and marks the rest, instead of losing everything to a client timeout.
# Validated at HTTP startup so a typo cannot ship as "only the chains are dead".
# MCP_CHAIN_DEADLINE_MS=45000

# ── HTTP transport (au-law-mcp --mode http) ─────────────────────────────────
# Listening port. The --port flag wins over this.
# PORT=8000

# Bind address. Loopback is the default; a non-loopback host requires
# MCP_AUTH_TOKEN, or an explicit MCP_ALLOW_UNAUTHENTICATED_REMOTE=1.
# MCP_HTTP_HOST=127.0.0.1

# When set, /mcp requires `x-mcp-token: <token>` or `Authorization: Bearer
# <token>`. /health and / stay open so a load balancer can probe them.
# MCP_AUTH_TOKEN=replace-with-a-secret

# Set to 1 only for a deliberately public, unauthenticated deployment that has
# another access boundary in front of it. Emits a startup warning.
# MCP_ALLOW_UNAUTHENTICATED_REMOTE=0

# Number of trusted reverse-proxy hops, 1 to 10. Never "true": trusting every
# hop makes X-Forwarded-For — and so the per-IP rate limit — client-controlled.
# TRUST_PROXY=1

# Access-Control-Allow-Origin for requests that carry no Origin header. Setting
# it explicitly also lets that origin pass Origin validation.
# CORS_ORIGIN=*

# Comma-separated Origin allowlist (DNS-rebinding defence). A request carrying
# an Origin header is refused unless it is listed. Requests without an Origin —
# ordinary MCP clients — are unaffected.
# ALLOWED_ORIGINS=https://example.com,https://other.example.com

# tools/call per minute per IP. 0 disables only this limiter; the batch cap and
# the execution budgets stay active. The handshake is never rate limited.
# RATE_LIMIT_RPM=60

# Maximum tools/call items in one JSON-RPC envelope. A batch dispatches every
# element, so this is what stops one request multiplying the quota.
# MCP_MAX_BATCH_CALLS=20

# Maximum incoming JSON request size, in bytes. The older MCP_BODY_LIMIT
# spelling ("100kb", "1mb") is still accepted and validated the same way.
# MCP_MAX_BODY_BYTES=102400

# Set to 0 to reject the `?apikey=` query-string key: query strings end up in
# proxy access logs in plain text. Headers are unaffected.
# ALLOW_QUERY_API_KEY=1

# Set to 1 for one log line per request. The path only — never the query
# string, which can carry a key.
# ACCESS_LOG=0

# ── Shared upstream allowance ───────────────────────────────────────────────
# These bound this server's total footprint on the public sources it reads —
# several are scraped sites that ask for a politeness interval, and none of them
# is a paid quota that a per-user key could isolate. Counted per tools/call.
# Refill per minute (0 blocks every tool call), and the burst the bucket holds.
# FALLBACK_RATE_LIMIT_RPM=120
# FALLBACK_RATE_LIMIT_BURST=120

# Rolling 24-hour total call cap for that shared path. 0 disables it.
# FALLBACK_DAILY_CAP=0
