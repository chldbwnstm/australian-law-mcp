# australian-law-mcp — environment variables
#
# There is NO API key. Every upstream source this server talks to is a keyless
# public endpoint, so the server starts with no credentials configured. The
# request context still carries an optional per-request API key (see
# src/lib/session-state.ts) so a future source that needs one can be plugged in
# without reworking the transport; the HTTP transport reads it from the `apikey`
# header. Leave it unset unless such a source is added.

# ── Upstream HTTP behaviour ─────────────────────────────────────────────────
# Some upstream sites reject Node's default undici user agent. Override the
# browser-like default here if a source needs a different one.
# LAW_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Sent as the Referer header on every upstream request when set. Unset by
# default — only some sources require it.
# LAW_REFERER=https://www.legislation.gov.au/

# ── Per-request execution limits ────────────────────────────────────────────
# All numeric limits are validated as whole integers at read time. A malformed
# value fails loudly instead of silently disabling the limit.

# Request-wide upstream attempt budget, including retries.
# MCP_MAX_UPSTREAM_REQUESTS=48

# Maximum bytes read from one upstream response body (2 MiB).
# MCP_MAX_UPSTREAM_BODY_BYTES=2097152

# Maximum upstream body bytes read by one outer request (8 MiB).
# MCP_MAX_TOTAL_UPSTREAM_BODY_BYTES=8388608

# Maximum characters returned in one MCP tool response.
# MCP_MAX_TOOL_RESPONSE_CHARS=50000

# Deadline for multi-step chain tools. On expiry the chain assembles whatever
# arrived and marks the rest, instead of losing everything to a client timeout.
# MCP_CHAIN_DEADLINE_MS=45000

# ── HTTP transport (used once the server layer lands) ───────────────────────
# PORT=8000
# MCP_HTTP_HOST=127.0.0.1
# MCP_AUTH_TOKEN=replace-with-a-secret
# MCP_ALLOW_UNAUTHENTICATED_REMOTE=0
# CORS_ORIGIN=*
# ALLOWED_ORIGINS=https://example.com,https://other.example.com
# TRUST_PROXY=1
# RATE_LIMIT_RPM=60
# MCP_MAX_BATCH_CALLS=20
# MCP_MAX_BODY_BYTES=102400

# Rolling 24-hour total call cap for the shared fallback path. 0 disables it.
# FALLBACK_DAILY_CAP=0
